      "css": ".ds-field{display:grid;gap:5px;font:12px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft Yahei\",sans-serif;color:var(--sub,#606b7c)}.ds-input{font:14px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft Yahei\",sans-serif;min-width:0;min-height:40px;background:#fff;border:1px solid var(--line,#dfe4ec);border-radius:7px;padding:9px 11px;color:var(--txt,#202632);caret-color:var(--accent,#245cd6)}.ds-input::placeholder{color:#667184}.ds-input:focus{outline:2px solid var(--focus,#245cd6);outline-offset:1px}"
