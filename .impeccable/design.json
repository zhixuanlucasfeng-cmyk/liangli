  "components": [
    {
      "name": "主操作按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "深红／夜间珊瑚红的主要操作。",
      "html": "<button class=\"ds-primary\">加入今日</button>",
      "css": ".ds-primary{min-height:40px;padding:9px 14px;border:1px solid var(--accent,#9a3836);border-radius:3px;font:700 13px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif;cursor:pointer;transition:background-color .15s,color .15s;background:var(--accent,#9a3836);color:var(--on-accent,#fff3e3)}.ds-primary:hover:not(:disabled){filter:brightness(.94)}.ds-primary:disabled{opacity:.48;cursor:not-allowed}.ds-primary:focus-visible{outline:2px solid var(--focus,var(--accent,#9a3836));outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "次操作按钮",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "纸面按钮，悬停加深墨线。",
      "html": "<button class=\"ds-ghost\">更多安排</button>",
      "css": ".ds-ghost{min-height:40px;padding:9px 14px;border:1px solid var(--accent,#9a3836);border-radius:3px;font:700 13px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif;cursor:pointer;transition:background-color .15s,color .15s;border-color:var(--line,#a29e90);background:var(--card,#f0ebde);color:var(--txt,#282927)}.ds-ghost:hover:not(:disabled){filter:brightness(.94);border-color:var(--ink,#30332f)}.ds-ghost:disabled{opacity:.48;cursor:not-allowed}.ds-ghost:focus-visible{outline:2px solid var(--focus,var(--accent,#9a3836));outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
    },
    {
      "name": "纸面输入",
      "kind": "input",
      "refersTo": "input",
      "description": "深灰细边框、纸底与红色焦点，日夜均保持可读。",
      "html": "<label class=\"ds-field\">任务<input class=\"ds-input\" placeholder=\"今天想完成什么？\"></label>",
      "css": ".ds-field{display:grid;gap:5px;font:12px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif;color:var(--sub,#57564e)}.ds-input{min-height:40px;min-width:0;padding:9px 11px;border:1px solid var(--sub,#57564e);border-radius:3px;background:var(--card,#f0ebde);color:var(--txt,#282927);font:14px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif;caret-color:var(--accent,#9a3836)}.ds-input::placeholder{color:var(--sub,#57564e)}.ds-input:focus{outline:2px solid var(--focus,var(--accent,#9a3836));outline-offset:1px}"
    },
    {
      "name": "左侧导航",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "墨线框选中状态；窄屏保留图标和可访问名称。",
      "html": "<nav class=\"ds-nav\" aria-label=\"工作台\"><button class=\"ds-nav-item\" aria-current=\"page\" aria-label=\"今日\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg><span>今日</span></button><button class=\"ds-nav-item\" aria-label=\"想法\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 17c0-3-3-4-3-8a7 7 0 0114 0c0 4-3 5-3 8M8 17h8M9 21h6\"/></svg><span>想法</span></button></nav>",
      "css": ".ds-nav{display:grid;gap:5px;padding:16px 12px;background:var(--sidebar,#d2ccbd);border-right:2px solid var(--ink,#30332f)}.ds-nav-item{display:flex;align-items:center;gap:11px;min-height:40px;padding:11px 12px;border:1px solid transparent;border-radius:3px;background:transparent;color:var(--sub,#57564e);font:600 13px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif;cursor:pointer;transition:background-color .15s,color .15s}.ds-nav-item svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8}.ds-nav-item[aria-current=page]{background:var(--accent,#9a3836);color:var(--on-accent,#fff3e3);border-color:var(--ink,#30332f);font-weight:650}.ds-nav-item:hover:not([aria-current=page]){background:var(--card2,#e4dfd1)}.ds-nav-item:hover{filter:brightness(.97)}.ds-nav-item:focus-visible{outline:2px solid var(--focus,var(--accent,#9a3836));outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
    {
      "name": "被动标签",
      "kind": "chip",
      "refersTo": "tag",
      "description": "列表内的次要元信息，窄手机布局可隐藏。",
      "html": "<span class=\"ds-tag\">25</span>",
      "css": ".ds-tag{display:inline-block;padding:3px 7px;border-radius:3px;background:var(--card2,#e4dfd1);color:var(--sub,#57564e);white-space:nowrap;font:11px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif}"
    },
    {
      "name": "墨线纸页面板",
      "kind": "card",
      "refersTo": "card",
      "description": "实色内容面与直接标题签，不叠加纹理或投影。",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-panel-tab\">今日任务</h2><p class=\"ds-copy\">把精力留给重要的事。</p></section>",
      "css": ".ds-card{padding:22px;background:var(--card,#f0ebde);color:var(--txt,#282927);border:2px solid var(--ink,#30332f);border-radius:3px;display:flex;flex-direction:column;font:14px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif}.ds-panel-tab{width:fit-content;max-width:100%;margin:-1px 0 14px;padding:4px 10px;background:var(--ink,#30332f);color:var(--bg,#ded9cd);font-size:14px;font-weight:750;line-height:1.35}.ds-copy{margin:0}"
    },
    {
      "name": "夜间模式开关",
      "kind": "button",
      "refersTo": "theme-toggle",
      "description": "40px 月亮按钮；按下状态代表夜间模式，状态由宿主同步。",
      "html": "<button class=\"ds-theme\" aria-label=\"夜间模式\" title=\"夜间模式\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20.5 13.2A8.6 8.6 0 0110.8 3.5 8.7 8.7 0 1020.5 13.2Z\"/></svg></button>",
      "css": ".ds-theme{display:grid;place-items:center;width:40px;height:40px;min-height:40px;padding:9px;background:var(--card,#f0ebde);color:var(--txt,#282927);border:1px solid var(--line,#a29e90);border-radius:3px;cursor:pointer;transition:background-color .15s,color .15s}.ds-theme svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linejoin:round}.ds-theme[aria-pressed=true]{background:var(--selected-bg,#e8cfc4);color:var(--selected-text,#7b2929);border-color:var(--selected-border,#9a3836)}.ds-theme:hover{filter:brightness(.97)}.ds-theme:focus-visible{outline:2px solid var(--focus,var(--accent,#9a3836));outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-theme{transition:none}}"
    },
    {
      "name": "视口分页",
      "kind": "custom",
      "refersTo": "pager-button",
      "description": "范围播报与边界禁用；页容量由实际可用高度决定。",
      "html": "<div class=\"ds-pager\"><span role=\"status\" aria-live=\"polite\">1–3 / 8 条</span><div class=\"ds-pager-actions\"><button class=\"ds-page\" aria-label=\"上一页\" disabled>‹</button><button class=\"ds-page\" aria-label=\"下一页\">›</button></div></div>",
      "css": ".ds-pager{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding-top:14px;border-top:1px solid var(--line,#a29e90);color:var(--sub,#57564e);font:12px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft Yahei',sans-serif}.ds-pager-actions{display:flex;gap:6px}.ds-page{min-width:36px;min-height:34px;border:1px solid var(--line,#a29e90);border-radius:3px;background:var(--card,#f0ebde);color:var(--txt,#282927);font:inherit;cursor:pointer;transition:background-color .15s,color .15s}.ds-page:hover:not(:disabled){filter:brightness(.97)}.ds-page:disabled{opacity:.48;cursor:not-allowed}.ds-page:focus-visible{outline:2px solid var(--focus,var(--accent,#9a3836));outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-page{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "校园漫画手账",
    "overview": "Powvy Habit 是一本可以操作的校园漫画手账：暖灰纸张、炭黑墨线、深红选择状态与细密网点承载日常记录。熟睡的 Power 灵感小角猫是品牌锚点；左侧导航、紧凑表单和视口分页维持清楚的工作秩序。\n\n夜间模式把纸面换为石墨色、文字换为暖米色、交互换为浅珊瑚红，保持同一结构与印刷感。本规范记录 workspace.css、theme.js、workspace.js 和 index.html 的最终实现；已替代旧蓝白视觉。用户可见名称统一为 Powvy Habit，兼容性相关标识保持稳定。",
    "keyCharacteristics": [
      "暖纸／石墨双主题，墨线框与网点留白。",
      "小角猫与两行字标构成紧凑品牌区。",
      "左侧导航常驻，窄屏采用图标栏与操作／记录切换。",
      "列表按视口高度分页，完整内容可通过详情读取。"
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "网点只铺在工作区背景与面板间隙；内容面板使用实色纸面，正文不叠加纹理。",
        "section": "colors"
      },
      {
        "name": "The Same Notebook Rule",
        "body": "日夜主题共享结构、控件尺寸和状态语义，只切换配色；主题切换不改变工作数据。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 使用当前主题的语义变量，保持日夜两套状态一致。",
      "Do 保留睡猫品牌、左侧栏、墨线框和网点留白。",
      "Do 根据可用高度分页，并保留完整文本、键盘焦点和局部滚动。",
      "Do 保留低高度滚动例外、中英文标签及可访问名称。"
    ],
    "donts": [
      "Don't 恢复纯白画布、蓝色主强调或旧的干净 SaaS 视觉。",
      "Don't 把网点铺进表单文字与长内容，或用大插画挤占工作空间。",
      "Don't 为无滚动外观裁掉必要内容，或将左侧栏改为底部导航。",
      "Don't 因品牌改名迁移兼容性相关的数据键、协议或应用标识。",
      "Don't 将 sidecar 的预览色阶当作新增应用令牌。"
    ]
  }
}
