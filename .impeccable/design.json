  "narrative": {
    "northStar": "安静的个人工作台",
    "overview": "Powy 使用中性浅色画布、白色工作面板、石墨色文字和克制的蓝色交互状态。界面为日常操作服务：通过左侧导航进入工具，在有限视口中输入、检查和处理数据。\n\n用户已确定干净的侧栏应用方向，保留 Powy 名称，移除漫画、Chainsaw Man 和 Power 角色装饰。系统字体、细边框、适度圆角和紧凑密度延续这一方向。本文件记录已构建的界面，以 `workspace.css`、`workspace.js` 和 `index.html` 为事实来源；不增加新的品牌假设。",
    "keyCharacteristics": [
      "浅色中性底色，蓝色标记操作和选中状态。",
      "左侧导航与工作面板构成稳定的操作空间。",
      "长列表分页，完整文本按需展开。",
      "中英文共用系统字体与组件结构。"
    ],
    "rules": [],
    "dos": [
      "Do 保留中性浅色、细描边、系统字体和左侧导航。",
      "Do 根据真实可用高度分页，提供完整文本和键盘访问路径。",
      "Do 在紧凑屏幕切换编辑与记录，允许英文页签自然换行。",
      "Do 保留低高度页面滚动和长内容局部滚动的可访问性例外。",
      "Do 将选中状态、焦点和禁用状态同时表达为语义与视觉反馈。"
    ],
    "donts": [
      "Don't 重新引入漫画、Chainsaw Man 或 Power 角色装饰。",
      "Don't 用超大宣传标题、装饰插画或额外卡片层级挤占操作区域。",
      "Don't 为满足无滚动外观而隐藏必要内容或裁掉操作。",
      "Don't 将此文件中的预览色阶当作新增应用颜色令牌。"
    ]
  }
}
